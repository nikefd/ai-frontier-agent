# ─── ai-frontier-agent config ──────────────────────────────────────
# Copy to .env and edit. All variables prefixed AIF_.

# HTTP server
AIF_HOST=0.0.0.0
AIF_PORT=9702

# Data root — articles.json / tracks.json / ui.db / reader-cache all live here.
AIF_DATA_DIR=/data

# LLM — DeepSeek (OpenAI-compatible). Same key serves chat agent + workers.
# Falls back to DEEPSEEK_API_KEY env var if AIF_LLM_API_KEY is empty.
AIF_LLM_BASE_URL=https://api.deepseek.com
AIF_LLM_MODEL=deepseek-chat
AIF_LLM_API_KEY=

# Scheduler
AIF_SCHEDULER_ENABLED=1
AIF_AI_NEWS_CRON_HOUR=7
AIF_AI_NEWS_CRON_MINUTE=30

AIF_LOG_LEVEL=INFO
