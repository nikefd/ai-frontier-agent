# ─── ai-frontier-agent config ──────────────────────────────────────
# Copy to .env and edit. All variables prefixed AIF_.

# HTTP server
AIF_HOST=0.0.0.0
AIF_PORT=9702

# Data root — articles.json / tracks.json / ui.db / reader-cache all live here.
AIF_DATA_DIR=./data

# LLM — DeepSeek (OpenAI-compatible). Same key serves chat agent + workers.
# Falls back to DEEPSEEK_API_KEY env var if AIF_LLM_API_KEY is empty.
AIF_LLM_BASE_URL=https://api.deepseek.com
AIF_LLM_MODEL=deepseek-chat
AIF_LLM_API_KEY=

# Scheduler
AIF_SCHEDULER_ENABLED=1
# 每 4 小时抓取，05:00 为锚点（01/05/09/13/17/21；Asia/Shanghai）
AIF_AI_NEWS_CRON_HOUR=5
AIF_AI_NEWS_CRON_MINUTE=0
AIF_AI_NEWS_INTERVAL_HOURS=4
# 高时效官方源每小时第 10 分钟抓取；论文/X/Trending 每 12 小时第 20 分钟抓取
AIF_FAST_NEWS_CRON_MINUTE=10
AIF_FAST_NEWS_INTERVAL_HOURS=1
AIF_SLOW_NEWS_CRON_HOUR=5
AIF_SLOW_NEWS_CRON_MINUTE=20
AIF_SLOW_NEWS_INTERVAL_HOURS=12
# 每 4 小时刷新速报，06:00 为锚点；候选不变时不调用 LLM
AIF_SUMMARY_CRON_HOUR=6
AIF_SUMMARY_CRON_MINUTE=0
AIF_SUMMARY_INTERVAL_HOURS=4

# 自建 RSSHub（docker-compose 内默认 http://rsshub:1200）；裸机可指向公共实例
AIF_RSSHUB_BASE=http://rsshub:1200
# Twitter 抓取 cookie：x.com 的 auth_token（登录态，勿提交 git；在部署环境手填）
TWITTER_AUTH_TOKEN=

AIF_LOG_LEVEL=INFO

# ─── Auth / 多用户 ────────────────────────────────────────────────
# 会话 cookie 的签名密钥。留空则自动生成并落 <data_dir>/auth/secret.key；
# 生产建议显式配置，否则容器重建会让所有人被登出。生成示例：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AIF_SECRET_KEY=
# 会话有效期（天）
AIF_SESSION_MAX_AGE_DAYS=30
# 是否给会话 cookie 加 Secure 标记（HTTPS 部署设 1）
AIF_COOKIE_SECURE=0
# 仅指定旧数据继承邮箱，不授予管理员身份；首个管理员须通过服务器端 bootstrap_admin 创建
AIF_ADMIN_EMAIL=
# 每个（已验证）用户每天的 LLM 操作额度，防滥用；admin 不限；0=不限。默认 50
AIF_DAILY_LLM_LIMIT=50
# 允许的跨域来源（逗号分隔）。用 cookie 鉴权时不能用 "*"。
# 留空 = 仅同源（内置 UI 够用，不需要额外来源）
AIF_CORS_ORIGINS=

# ─── 邮箱验证 / SMTP ──────────────────────────────────────────────
# 全部可选：host/user/password 留空则不发验证邮件（注册照常，只是没验证信）。
# 起步可用自己的 SMTP 账号；Gmail 需先开两步验证，再生成「应用专用密码」填到下面，
# 不是 Gmail 登录密码。换 SendGrid 时：host=smtp.sendgrid.net user=apikey password=<API Key>。
AIF_SMTP_HOST=smtp.gmail.com
AIF_SMTP_PORT=587
AIF_SMTP_USER=
AIF_SMTP_PASSWORD=
# 发件人地址；留空则用 AIF_SMTP_USER
AIF_SMTP_FROM=
# 站点公开地址，用于拼验证链接（如 https://ai.example.com）。留空则不发验证信。
AIF_PUBLIC_BASE_URL=
