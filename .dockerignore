# Don't ship local build artifacts / deps into the Docker build context —
# the frontend is rebuilt inside the Node stage.
frontend/node_modules/
static/dist/
.venv/
.venv-run/
__pycache__/
*.pyc
.pytest_cache/
.git/
/data/
.env

# Local audit reports, scanner tools and private diagnostics
.run/
*.egg-info/
.env.*
!.env.example

# Python package build artifacts
build/
dist/

# Generated by frontend/scripts/licenses.mjs during builds
frontend/public/THIRD_PARTY_LICENSES.txt

# Private data backups and restore snapshots
backups/
*.aif-backup.tar.gz
